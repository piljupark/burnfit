rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentUser() {
      return userDoc(request.auth.uid).data;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 역할 권한은 승인된(approved) 계정에만 부여한다.
    // 승인 대기·거절 계정은 isOwner()로 자기 문서만 다룰 수 있다.
    function hasApprovedRole(role) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUser().role == role &&
        currentUser().status == 'approved';
    }

    function isAdmin() {
      return hasApprovedRole('admin');
    }

    function isTrainer() {
      return hasApprovedRole('trainer');
    }

    function isMember() {
      return hasApprovedRole('member');
    }

    function centerDoc(centerId) {
      return get(/databases/$(database)/documents/centers/$(centerId));
    }

    function isActiveCenter(centerId) {
      return centerId is string &&
        exists(/databases/$(database)/documents/centers/$(centerId)) &&
        centerDoc(centerId).data.status == 'active';
    }

    function sameCenter(centerId) {
      return signedIn() && currentUser().centerId == centerId;
    }

    function isCenterAdmin(centerId) {
      return isAdmin() && sameCenter(centerId);
    }

    function isAssignedTrainer(memberId) {
      return isTrainer() &&
        exists(/databases/$(database)/documents/users/$(memberId)) &&
        userDoc(memberId).data.trainerId == request.auth.uid &&
        userDoc(memberId).data.centerId == currentUser().centerId;
    }

    function shares(memberId, key) {
      return isAssignedTrainer(memberId) &&
        (
          !('shareSettings' in userDoc(memberId).data) ||
          !(key in userDoc(memberId).data.shareSettings) ||
          userDoc(memberId).data.shareSettings[key] == true
        );
    }

    function canReadMemberScoped(centerId, memberId, shareKey) {
      return isOwner(memberId) ||
        isCenterAdmin(centerId) ||
        (shareKey == 'none' && isAssignedTrainer(memberId)) ||
        (shareKey == 'workout' && shares(memberId, 'workout')) ||
        (shareKey == 'meal' && shares(memberId, 'meal')) ||
        (shareKey == 'body' && shares(memberId, 'body'));
    }

    function canWriteOwnMemberScoped(centerId, memberId) {
      return isOwner(memberId) && isMember() && sameCenter(centerId);
    }

    function canLinkFeedback(centerId, memberId, shareKey) {
      return sameCenter(centerId) &&
        (
          isCenterAdmin(centerId) ||
          (shareKey == 'workout' && shares(memberId, 'workout')) ||
          (shareKey == 'meal' && shares(memberId, 'meal'))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hasFeedback',
          'feedbackId',
          'updatedAt'
        ]);
    }

    function hasOnlyJoinRequestFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'userId',
        'userName',
        'userEmail',
        'centerId',
        'centerName',
        'role',
        'status',
        'createdAt'
      ]);
    }

    function canUpdateJoinRequestStatus() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status'
      ]) &&
      request.resource.data.status in ['approved', 'rejected'];
    }

    function hasOnlyWorkoutFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'centerId',
        'memberId',
        'memberName',
        'trainerId',
        'workoutType',
        'createdById',
        'createdByRole',
        'ptSessionId',
        'workoutDate',
        'category',
        'exercises',
        'note',
        'hasFeedback',
        'feedbackId',
        'createdAt',
        'updatedAt',
        'durationSeconds'
      ]);
    }

    function hasOnlyMealFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'centerId',
        'memberId',
        'memberName',
        'trainerId',
        'mealType',
        'mealDate',
        'mealTime',
        'imageUrls',
        'description',
        'calories',
        'hasFeedback',
        'feedbackId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasOnlyCardioFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'centerId',
        'memberId',
        'memberName',
        'trainerId',
        'cardioDate',
        'type',
        'durationMinutes',
        'speed',
        'intensity',
        'name',
        'note',
        'hasFeedback',
        'feedbackId',
        'createdAt',
        'updatedAt'
      ]);
    }

    // 신체 정보는 users/{uid}/body_profile/current에 따로 둔다 (공유 설정을 규칙으로 지키려고).
    // 사용자 문서의 예전 'profile' 필드는 새로 쓸 수 없고 지우기만 한다.
    function removesLegacyProfileOnly() {
      return !('profile' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.get('profile', null) == null;
    }

    function isOptionalNumberIn(d, key, min, max) {
      return d.get(key, null) == null ||
        (d[key] is number && d[key] >= min && d[key] <= max);
    }

    // 앱 검증 범위(Validators.bodyMetrics)와 같다.
    function hasValidBodyProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'height', 'weight', 'muscleMass', 'bodyFat', 'goal', 'updatedAt'
        ]) &&
        isOptionalNumberIn(d, 'height', 50, 250) &&
        isOptionalNumberIn(d, 'weight', 20, 300) &&
        isOptionalNumberIn(d, 'muscleMass', 5, 100) &&
        isOptionalNumberIn(d, 'bodyFat', 1, 150) &&
        (d.get('goal', null) == null || (d.goal is string && d.goal.size() <= 200)) &&
        d.updatedAt == request.time;
    }

    function hasValidShareSettings() {
      return !('shareSettings' in request.resource.data) ||
        request.resource.data.shareSettings.keys().hasOnly([
          'workout',
          'meal',
          'body'
        ]);
    }

    function hasOnlyInbodyFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'centerId',
        'memberId',
        'memberName',
        'trainerId',
        'measurementDate',
        'weight',
        'muscleMass',
        'bodyFat',
        'bodyFatPercent',
        'bmi',
        'bmr',
        'visceralFat',
        'leftArm',
        'rightArm',
        'trunk',
        'leftLeg',
        'rightLeg',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasOnlyPtInfoFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'centerId',
        'memberId',
        'memberName',
        'trainerId',
        'startDate',
        'endDate',
        'totalSessions',
        'remainingSessions',
        'renewalDate',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasOnlyPtSessionFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'centerId',
        'trainerId',
        'trainerName',
        'memberId',
        'memberName',
        'scheduledAt',
        'durationMinutes',
        'note',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    // 담당 트레이너는 회원에게만, 같은 센터의 승인된 트레이너로만 (해제는 null).
    function hasValidTrainerAssignment() {
      let trainerId = request.resource.data.get('trainerId', null);
      return !('trainerId' in request.resource.data.diff(resource.data).affectedKeys()) ||
        (
          resource.data.role == 'member' &&
          (
            trainerId == null ||
            (
              trainerId is string &&
              exists(/databases/$(database)/documents/users/$(trainerId)) &&
              userDoc(trainerId).data.role == 'trainer' &&
              userDoc(trainerId).data.status == 'approved' &&
              userDoc(trainerId).data.centerId == resource.data.centerId
            )
          )
        );
    }

    function canAdminUpdateUser() {
      return resource.data.role in ['member', 'trainer'] &&
        hasValidTrainerAssignment() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'trainerId',
        'trainerName',
        'updatedAt'
      ]) &&
      (
        !('status' in request.resource.data) ||
        request.resource.data.status in ['pending', 'approved', 'rejected']
      );
    }

    // PT 횟수: 정수, 0 이상, 잔여 ≤ 전체.
    function hasValidPtCounts() {
      let total = request.resource.data.totalSessions;
      let remaining = request.resource.data.remainingSessions;
      return total is int && remaining is int &&
        total >= 0 && remaining >= 0 && remaining <= total;
    }

    // 회원이 같은 센터 소속인지 (다른 센터 회원에게 PT·알림을 만들지 못하게).
    function isMemberOfCenter(memberId, centerId) {
      return exists(/databases/$(database)/documents/users/$(memberId)) &&
        userDoc(memberId).data.centerId == centerId &&
        userDoc(memberId).data.role == 'member';
    }

    function canAdminCreatePtInfo(ptInfoId) {
      return isCenterAdmin(request.resource.data.centerId) &&
        hasOnlyPtInfoFields() &&
        request.resource.data.id == ptInfoId &&
        hasValidPtCounts() &&
        isMemberOfCenter(request.resource.data.memberId, request.resource.data.centerId);
    }

    function canAdminUpdatePtInfo() {
      return isCenterAdmin(resource.data.centerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trainerId',
          'startDate',
          'endDate',
          'totalSessions',
          'remainingSessions',
          'renewalDate',
          'updatedAt'
        ]) &&
        hasValidPtCounts();
    }

    // PT 일정은 '예약' 상태로만 만든다. 완료·완료 취소는 서버 함수(setPtSessionStatus)가 잔여 횟수와 함께 바꾼다.
    function canCreateScheduledPtSession(sessionId) {
      return hasOnlyPtSessionFields() &&
        request.resource.data.id == sessionId &&
        request.resource.data.status == 'scheduled' &&
        isMemberOfCenter(request.resource.data.memberId, request.resource.data.centerId);
    }

    function canAdminCreatePtSession(sessionId) {
      return isCenterAdmin(request.resource.data.centerId) &&
        canCreateScheduledPtSession(sessionId);
    }

    function canUpdatePtSessionTrainer() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'trainerId',
        'trainerName',
        'updatedAt'
      ]);
    }

    function canCreateInbody(inbodyId) {
      return hasOnlyInbodyFields() &&
        request.resource.data.id == inbodyId &&
        (
          isCenterAdmin(request.resource.data.centerId) ||
          (
            isTrainer() &&
            sameCenter(request.resource.data.centerId) &&
            request.resource.data.trainerId == request.auth.uid &&
            isAssignedTrainer(request.resource.data.memberId)
          )
        );
    }

    function canUpdateInbodyContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'measurementDate',
        'weight',
        'muscleMass',
        'bodyFat',
        'bodyFatPercent',
        'bmi',
        'bmr',
        'visceralFat',
        'leftArm',
        'rightArm',
        'trunk',
        'leftLeg',
        'rightLeg',
        'updatedAt'
      ]);
    }

    function hasOnlyCustomExerciseFields() {
      return request.resource.data.keys().hasOnly([
        'id',
        'memberId',
        'name',
        'category',
        'createdAt'
      ]);
    }

    function canCreateOwnWorkout(workoutId) {
      return canWriteOwnMemberScoped(
        request.resource.data.centerId,
        request.resource.data.memberId
      ) &&
      hasOnlyWorkoutFields() &&
      request.resource.data.id == workoutId &&
      request.resource.data.createdById == request.auth.uid &&
      request.resource.data.createdByRole == 'member' &&
      request.resource.data.workoutType == 'personal' &&
      request.resource.data.hasFeedback == false &&
      request.resource.data.feedbackId == null;
    }

    function canCreateTrainerPtWorkout(workoutId) {
      return isTrainer() &&
        sameCenter(request.resource.data.centerId) &&
        hasOnlyWorkoutFields() &&
        request.resource.data.id == workoutId &&
        request.resource.data.trainerId == request.auth.uid &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.createdByRole == 'trainer' &&
        request.resource.data.workoutType == 'pt' &&
        request.resource.data.hasFeedback == false &&
        request.resource.data.feedbackId == null &&
        isAssignedTrainer(request.resource.data.memberId);
    }

    function canUpdateWorkoutContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'category',
        'exercises',
        'note',
        'updatedAt',
        'durationSeconds'
      ]);
    }

    function canCreateOwnMeal(mealId) {
      return canWriteOwnMemberScoped(
        request.resource.data.centerId,
        request.resource.data.memberId
      ) &&
      hasOnlyMealFields() &&
      request.resource.data.id == mealId &&
      request.resource.data.hasFeedback == false &&
      request.resource.data.feedbackId == null;
    }

    function canUpdateMealContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'mealType',
        'mealDate',
        'mealTime',
        'imageUrls',
        'description',
        'calories',
        'updatedAt'
      ]);
    }

    function canCreateOwnCardio(cardioId) {
      return canWriteOwnMemberScoped(
        request.resource.data.centerId,
        request.resource.data.memberId
      ) &&
      hasOnlyCardioFields() &&
      request.resource.data.id == cardioId &&
      request.resource.data.hasFeedback == false &&
      request.resource.data.feedbackId == null;
    }

    function canUpdateCardioContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'cardioDate',
        'type',
        'durationMinutes',
        'speed',
        'intensity',
        'name',
        'note',
        'updatedAt'
      ]);
    }

    function canUpdateFeedbackContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'content',
        'updatedAt'
      ]);
    }

    function canUpdatePtSessionSchedule() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'scheduledAt',
        'durationMinutes',
        'note',
        'updatedAt'
      ]);
    }

    function canCreatePtInfoLog() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ptInfoId',
        'centerId',
        'memberId',
        'memberName',
        'changedById',
        'changedByName',
        'type',
        'previousTotalSessions',
        'nextTotalSessions',
        'previousRemainingSessions',
        'nextRemainingSessions',
        'ptSessionId',
        'note',
        'createdAt'
      ]);
    }

    // 생년월일은 'yyyyMMdd' 8자리 숫자 문자열 (온보딩·프로필 편집). 바꿀 때만 검사해
    // 예전 형식으로 남은 값이 다른 필드 수정(알림 토큰 등)을 막지 않게 한다.
    function hasValidBirthDateChange() {
      return !('birthDate' in request.resource.data.diff(resource.data).affectedKeys()) ||
        request.resource.data.birthDate == null ||
        (request.resource.data.birthDate is string &&
          request.resource.data.birthDate.matches('^[0-9]{8}$'));
    }

    function canUpdateOwnUser() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'birthDate',
        'gender',
        'profile',
        'shareSettings',
        'fcmToken',
        'fcmTokenUpdatedAt',
        'updatedAt'
      ]) &&
      removesLegacyProfileOnly() &&
      hasValidShareSettings() &&
      hasValidBirthDateChange() &&
      (
        !('gender' in request.resource.data) ||
        request.resource.data.gender == null ||
        request.resource.data.gender in ['male', 'female', 'other']
      );
    }

    match /users/{uid} {
      // 클라이언트 가입은 회원/트레이너의 '승인 대기' 계정만 가능하다.
      // 관리자 계정과 센터는 서버 함수(registerCenterAdmin)만 만든다.
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'status', 'centerId', 'centerName',
          'trainerId', 'trainerName', 'birthDate', 'gender', 'profile',
          'shareSettings', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.role in ['member', 'trainer'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.email is string &&
        request.auth.token.email is string &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        isActiveCenter(request.resource.data.centerId) &&
        request.resource.data.centerName == centerDoc(request.resource.data.centerId).data.name &&
        request.resource.data.get('trainerId', null) == null &&
        request.resource.data.get('trainerName', null) == null &&
        request.resource.data.get('profile', null) == null &&
        hasValidShareSettings();

      allow get: if isOwner(uid) ||
        isCenterAdmin(resource.data.centerId) ||
        (
          isTrainer() &&
          resource.data.centerId == currentUser().centerId &&
          (
            resource.data.uid == request.auth.uid ||
            resource.data.trainerId == request.auth.uid ||
            resource.data.role == 'trainer'
          )
        );

      allow list: if signedIn() &&
        resource.data.centerId == currentUser().centerId &&
        (
          isAdmin() ||
          (
            isTrainer() &&
            (
              resource.data.role == 'trainer' ||
              (
                resource.data.role == 'member' &&
                resource.data.trainerId == request.auth.uid
              )
            )
          )
        );

      allow update: if (isOwner(uid) && canUpdateOwnUser()) ||
        (
          isCenterAdmin(resource.data.centerId) &&
          canAdminUpdateUser()
        );

      // 계정 삭제는 탈퇴 서버 함수(deleteMyAccount)만 한다 (PT 이력 보관 절차를 거치도록).
      allow delete: if false;
    }

    // 신체 정보: 본인·같은 센터 관리자, 그리고 회원이 신체 정보 공유를 켠 경우의 담당 트레이너만 읽는다.
    // 쓰기는 본인만. 탈퇴 시 서버가 사용자 문서와 함께 지운다.
    match /users/{uid}/body_profile/{docId} {
      allow read: if docId == 'current' &&
        (
          isOwner(uid) ||
          (
            exists(/databases/$(database)/documents/users/$(uid)) &&
            isCenterAdmin(userDoc(uid).data.centerId)
          ) ||
          shares(uid, 'body')
        );
      allow create, update: if docId == 'current' &&
        isOwner(uid) &&
        hasValidBodyProfile();
      allow delete: if false;
    }

    // 알림함: 서버 함수(notifyUser)만 만든다. 본인은 읽기, 읽음 처리, 삭제만 할 수 있다.
    match /users/{uid}/notifications/{notificationId} {
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt == request.time;
      allow create: if false;
    }

    match /centers/{centerId} {
      // 가입·로그인 화면의 센터 검색(운영 중인 센터)과 내 소속 센터만 읽는다.
      allow read: if resource.data.status == 'active' || sameCenter(centerId);
      // 센터 생성은 관리자 설정 코드를 검증하는 서버 함수만 한다.
      allow create: if false;
      // 센터 정보 변경·삭제는 서버에서만 한다 (앱에 해당 화면 없음).
      allow update, delete: if false;
    }

    // 탈퇴 회원의 PT 계약·이용 내역 (회원을 알 수 없게 바꾼 사본, 3년 보관 후 서버가 파기).
    // 분쟁 대응용으로 해당 센터 관리자만 읽고, 쓰기는 서버 함수만 한다.
    match /retained_pt_records/{recordId} {
      allow read: if isCenterAdmin(resource.data.centerId);
      allow write: if false;
    }

    match /join_requests/{requestId} {
      allow create: if signedIn() &&
        hasOnlyJoinRequestFields() &&
        request.resource.data.id == requestId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.role in ['member', 'trainer'] &&
        request.resource.data.status == 'pending' &&
        // 가입 시 사용자 문서와 같은 배치로 만들 수 있게 '쓰기 후' 상태로 확인한다.
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.centerId ==
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.centerId &&
        request.resource.data.role ==
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'pending';
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isCenterAdmin(resource.data.centerId)
        );
      allow update: if isCenterAdmin(resource.data.centerId) &&
        canUpdateJoinRequestStatus();
      allow delete: if isCenterAdmin(resource.data.centerId);
    }

    match /pt_infos/{ptInfoId} {
      allow read: if canReadMemberScoped(
        resource.data.centerId,
        resource.data.memberId,
        'none'
      );
      // PT권은 관리자만 만들고 고친다. 세션 완료에 따른 잔여 차감·복구는 서버 함수만 한다.
      allow create: if canAdminCreatePtInfo(ptInfoId);
      allow update: if canAdminUpdatePtInfo();
      allow delete: if false;
    }

    match /pt_info_logs/{logId} {
      allow read: if canReadMemberScoped(
        resource.data.centerId,
        resource.data.memberId,
        'none'
      );
      // 관리자의 PT권 등록·수정 기록만 앱에서 쓴다 (세션 완료 기록은 서버 함수가 쓴다).
      allow create: if isCenterAdmin(request.resource.data.centerId) &&
        canCreatePtInfoLog() &&
        request.resource.data.changedById == request.auth.uid;
      allow update, delete: if false;
    }

    match /pt_sessions/{sessionId} {
      allow read: if isOwner(resource.data.memberId) ||
        isCenterAdmin(resource.data.centerId) ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.trainerId == request.auth.uid
        );
      allow create: if canAdminCreatePtSession(sessionId) ||
        (
          isTrainer() &&
          sameCenter(request.resource.data.centerId) &&
          request.resource.data.trainerId == request.auth.uid &&
          isAssignedTrainer(request.resource.data.memberId) &&
          canCreateScheduledPtSession(sessionId)
        );
      // 상태(완료·취소)는 서버 함수만 바꾼다. 앱은 예약된 일정의 시간·메모와 담당 변경만.
      allow update: if resource.data.status == 'scheduled' &&
        (
          (
            isCenterAdmin(resource.data.centerId) &&
            (canUpdatePtSessionSchedule() || canUpdatePtSessionTrainer())
          ) ||
          (
            isTrainer() &&
            sameCenter(resource.data.centerId) &&
            resource.data.trainerId == request.auth.uid &&
            isAssignedTrainer(resource.data.memberId) &&
            canUpdatePtSessionSchedule()
          )
        );
      allow delete: if false;
    }

    match /workouts/{workoutId} {
      // 담당 트레이너는 회원의 운동 공유 설정과 관계없이 자기가 남긴 PT 기록은 읽는다.
      allow read: if canReadMemberScoped(
        resource.data.centerId,
        resource.data.memberId,
        'workout'
      ) ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.workoutType == 'pt' &&
          resource.data.trainerId == request.auth.uid &&
          isAssignedTrainer(resource.data.memberId)
        );
      // 운동 기록은 회원(개인)과 담당 트레이너(PT)만 만든다. 관리자는 정정·삭제만.
      allow create: if canCreateOwnWorkout(workoutId) ||
        canCreateTrainerPtWorkout(workoutId);
      allow update: if (
          canWriteOwnMemberScoped(resource.data.centerId, resource.data.memberId) &&
          resource.data.createdById == request.auth.uid &&
          canUpdateWorkoutContent()
        ) ||
        (
          isCenterAdmin(resource.data.centerId) &&
          (
            canUpdateWorkoutContent() ||
            canLinkFeedback(resource.data.centerId, resource.data.memberId, 'workout')
          )
        ) ||
        canLinkFeedback(resource.data.centerId, resource.data.memberId, 'workout') ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.trainerId == request.auth.uid &&
          resource.data.workoutType == 'pt' &&
          isAssignedTrainer(resource.data.memberId) &&
          canUpdateWorkoutContent()
        );
      allow delete: if canWriteOwnMemberScoped(
        resource.data.centerId,
        resource.data.memberId
      ) &&
        resource.data.createdById == request.auth.uid ||
        isCenterAdmin(resource.data.centerId) ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.trainerId == request.auth.uid &&
          resource.data.workoutType == 'pt' &&
          isAssignedTrainer(resource.data.memberId)
        );
    }

    match /cardios/{cardioId} {
      allow read: if canReadMemberScoped(
        resource.data.centerId,
        resource.data.memberId,
        'workout'
      );
      allow create: if canCreateOwnCardio(cardioId);
      allow update: if (
          canWriteOwnMemberScoped(resource.data.centerId, resource.data.memberId) &&
          canUpdateCardioContent()
        ) ||
        (
          isCenterAdmin(resource.data.centerId) &&
          (
            canUpdateCardioContent() ||
            canLinkFeedback(resource.data.centerId, resource.data.memberId, 'workout')
          )
        ) ||
        canLinkFeedback(resource.data.centerId, resource.data.memberId, 'workout');
      allow delete: if canWriteOwnMemberScoped(
        resource.data.centerId,
        resource.data.memberId
      ) || isCenterAdmin(resource.data.centerId);
    }

    match /meals/{mealId} {
      allow read: if canReadMemberScoped(
        resource.data.centerId,
        resource.data.memberId,
        'meal'
      );
      allow create: if canCreateOwnMeal(mealId);
      allow update: if (
          canWriteOwnMemberScoped(resource.data.centerId, resource.data.memberId) &&
          canUpdateMealContent()
        ) ||
        (
          isCenterAdmin(resource.data.centerId) &&
          (
            canUpdateMealContent() ||
            canLinkFeedback(resource.data.centerId, resource.data.memberId, 'meal')
          )
        ) ||
        canLinkFeedback(resource.data.centerId, resource.data.memberId, 'meal');
      allow delete: if canWriteOwnMemberScoped(
        resource.data.centerId,
        resource.data.memberId
      ) || isCenterAdmin(resource.data.centerId);
    }

    match /inbodies/{inbodyId} {
      allow read: if canReadMemberScoped(
        resource.data.centerId,
        resource.data.memberId,
        'body'
      );
      allow create: if canCreateInbody(inbodyId);
      allow update: if (
          isCenterAdmin(resource.data.centerId) ||
          (
            isTrainer() &&
            sameCenter(resource.data.centerId) &&
            resource.data.trainerId == request.auth.uid &&
            isAssignedTrainer(resource.data.memberId)
          )
        ) &&
        canUpdateInbodyContent();
      allow delete: if isCenterAdmin(resource.data.centerId) || (
        isTrainer() &&
        sameCenter(resource.data.centerId) &&
        resource.data.trainerId == request.auth.uid &&
        isAssignedTrainer(resource.data.memberId)
      );
    }

    match /feedbacks/{feedbackId} {
      allow read: if isOwner(resource.data.memberId) ||
        isCenterAdmin(resource.data.centerId) ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.trainerId == request.auth.uid &&
          isAssignedTrainer(resource.data.memberId)
        );
      allow create: if isTrainer() &&
        request.resource.data.keys().hasOnly([
          'id', 'centerId', 'trainerId', 'trainerName', 'memberId', 'memberName',
          'targetType', 'targetId', 'targetDate', 'content', 'readAt',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.id == feedbackId &&
        request.resource.data.get('readAt', null) == null &&
        request.resource.data.trainerName == currentUser().name &&
        sameCenter(request.resource.data.centerId) &&
        request.resource.data.trainerId == request.auth.uid &&
        isAssignedTrainer(request.resource.data.memberId);
      allow update: if (
          isCenterAdmin(resource.data.centerId) &&
          canUpdateFeedbackContent()
        ) ||
        (
          isOwner(resource.data.memberId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readAt',
            'updatedAt'
          ]) &&
          request.resource.data.readAt == request.time
        ) ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.trainerId == request.auth.uid &&
          isAssignedTrainer(resource.data.memberId) &&
          canUpdateFeedbackContent()
        );
      allow delete: if isCenterAdmin(resource.data.centerId) ||
        (
          isTrainer() &&
          sameCenter(resource.data.centerId) &&
          resource.data.trainerId == request.auth.uid &&
          isAssignedTrainer(resource.data.memberId)
        );
    }

    // 공지사항: 같은 센터의 승인된 사용자만 읽고, 대상(audience)이 맞아야 한다.
    // 작성·수정·삭제는 그 센터의 승인된 관리자만.
    function isApprovedSameCenter(centerId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUser().status == 'approved' &&
        currentUser().centerId == centerId;
    }

    function isValidNoticeContent() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'centerId', 'title', 'body', 'audience', 'pinned', 'important',
          'notify', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll([
          'centerId', 'title', 'body', 'audience', 'pinned', 'important',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        d.title is string && d.title.size() >= 1 && d.title.size() <= 40 &&
        d.body is string && d.body.size() >= 1 && d.body.size() <= 2000 &&
        d.audience in ['all', 'member', 'trainer'] &&
        d.pinned is bool &&
        d.important is bool &&
        d.get('notify', false) is bool &&
        d.updatedAt == request.time;
    }

    match /notices/{noticeId} {
      allow read: if isApprovedSameCenter(resource.data.centerId) &&
        (
          isCenterAdmin(resource.data.centerId) ||
          resource.data.audience == 'all' ||
          resource.data.audience == currentUser().role
        );
      allow create: if isCenterAdmin(request.resource.data.centerId) &&
        isValidNoticeContent() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update: if isCenterAdmin(resource.data.centerId) &&
        isValidNoticeContent() &&
        request.resource.data.centerId == resource.data.centerId &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isCenterAdmin(resource.data.centerId);
    }

    match /custom_exercises/{exerciseId} {
      allow create: if (isMember() || isTrainer()) &&
        hasOnlyCustomExerciseFields() &&
        request.resource.data.id == exerciseId &&
        request.resource.data.memberId == request.auth.uid &&
        request.resource.data.category in [
          'shoulder',
          'chest',
          'back',
          'lower',
          'arms',
          'abs',
          'cardio'
        ];
      allow read, delete: if signedIn() &&
        resource.data.memberId == request.auth.uid;
      allow update: if false;
    }
  }
}
